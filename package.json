{
	"name": "cloudly-http",
	"version": "1.1.0",
	"description": "Improved handling of HTTP Requests and Responses.",
	"author": "Utily Contributors",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/utily/cloudly-http"
	},
	"bugs": {
		"url": "https://github.com/utily/cloudly-http/issues"
	},
	"homepage": "https://github.com/utily/cloudly-http",
	"private": false,
	"type": "module",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"github": {
		"release": true
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"lint": "biome format .",
		"format": "biome check --write .",
		"test": "vitest --run",
		"coverage": "vitest --coverage",
		"prepare": "npm run build",
		"clean": "rimraf dist node_modules coverage",
		"verify": "npm run build && npm run test && npm run lint && npm audit --omit=dev"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.9",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/github": "^12.0.2",
		"@semantic-release/npm": "^13.1.3",
		"@semantic-release/release-notes-generator": "^14.1.0",
		"@vitest/coverage-v8": "5.1.2",
		"conventional-changelog-conventionalcommits": "^10.4.1",
		"rimraf": "6.1.4",
		"semantic-release": "^25.0.2",
		"typescript": "7.0.2",
		"vite": "8.4.0",
		"vitest": "5.1.2"
	}
}
