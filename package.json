{
	"name": "cloudly-http",
	"version": "0.1.8",
	"description": "Improved handling of HTTP Requests and Responses.",
	"author": "Simon Mika <simon@mika.se>",
	"license": "MIT",
	"repository": "https://github.com/utily/cloudly-http",
	"bugs": {
		"url": "https://github.com/utily/cloudly-http/issues"
	},
	"homepage": "https://github.com/utily/cloudly-http",
	"private": false,
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"git": {
		"tagName": "release-${version}"
	},
	"github": {
		"release": true
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"lint": "biome format .",
		"format": "biome format --write .",
		"test": "vitest --run",
		"coverage": "vitest --coverage",
		"verify": "npm run build && npm run test && npm run lint && npm audit --omit=dev",
		"clean": "rimraf dist node_modules coverage",
		"prepare": "npm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.9",
		"@semantic-release/commit-analyzer": "13.0.1",
		"@semantic-release/github": "12.0.11",
		"@semantic-release/npm": "13.2.0",
		"@semantic-release/release-notes-generator": "14.1.1",
		"@types/isomorphic-fetch": "0.0.36",
		"@vitest/coverage-v8": "5.1.2",
		"formdata-polyfill": "^4.0.10",
		"isomorphic-fetch": "^3.0.0",
		"rimraf": "6.1.4",
		"semantic-release": "26.0.1",
		"typescript": "5.9.3",
		"vite": "8.4.0",
		"vitest": "5.1.2"
	},
	"overrides": {
		"postcss": "8.4.31",
		"semver": "7.5.3"
	}
}
